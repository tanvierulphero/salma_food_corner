<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # api.php এবং uploads/ ফোল্ডারের ছবি সরাসরি সার্ভ করবে (কখনোই index.html এ যাবে না)
  RewriteRule ^api\.php$ - [L]
  RewriteRule ^uploads/ - [L]

  # /admin এ গেলে সরাসরি admin.html ওপেন হবে
  RewriteRule ^admin/?$ admin.html [L]

  # আসল ফাইল বা ফোল্ডার থাকলে সরাসরি সার্ভ করবে
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # বাকি সব রাউট index.html এ পাঠাবে (React SPA Routing)
  RewriteRule . /index.html [L]
</IfModule>

# API ও HTML ক্যাশিং বন্ধ রাখা যাতে সবসময় লাইভ ডাটা লোড হয়
<IfModule mod_headers.c>
  <FilesMatch "\.(php|html|json)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>
